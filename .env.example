# Agent Memory Platform - Production Environment Variables

# AI Model Credentials (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
EXTRACTION_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Database Configuration (PostgreSQL in Prod / SQLite in local dev)
DATABASE_URL=sqlite:///./memory_store.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memorybrain

# Redis Queue Configuration
REDIS_URL=redis://localhost:6379/0

# Encryption at Rest (32-byte urlsafe base64 key for AES-256 Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEMORY_ENCRYPTION_KEY=v_s4K3-x1g_bS9c6vT7rU9yP8wL4zM2aN0oP3eR6tY8=

# Server & SRE
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO
RATE_LIMIT_DEFAULT_RPM=120
MAX_PAYLOAD_SIZE_BYTES=1048576
