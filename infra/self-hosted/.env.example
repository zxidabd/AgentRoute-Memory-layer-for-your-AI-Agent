# =====================================================================================
# MEMORYBRAIN SELF-HOSTED OPEN-CORE ENVIRONMENT CONFIGURATION
# Copy to .env and populate before running: docker-compose up -d
# =====================================================================================

# 1. Database Credentials (PostgreSQL 16 + pgvector)
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here_min_32_chars

# 2. Redis Authentication (AOF Persistence)
REDIS_PASSWORD=generate_a_secure_redis_password_here_min_32_chars

# 3. Application Security & Field Encryption at Rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEMORY_ENCRYPTION_KEY=v_s4K3-x1g_bS9c6vT7rU9yP8wL4zM2aN0oP3eR6tY8=
JWT_SECRET=generate_a_secure_jwt_signing_key_here_min_64_chars

# 4. Open-Core Enterprise License Key (Optional)
# Leave blank for Free Community Edition (core store/recall/delete).
# Enter valid 'mb_lic_...' key for Enterprise Edition (RBAC, SAML SSO, Compliance Evidence).
MEMORYBRAIN_LICENSE_KEY=

# 5. Domain & Reverse Proxy
DOMAIN_NAME=memorybrain.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# 6. Performance & Rate Limiting
RATE_LIMIT_DEFAULT_RPM=120
MAX_PAYLOAD_SIZE_BYTES=1048576
